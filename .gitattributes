# 统一换行符，避免 Windows 批处理在别的机器上被 LF 破坏
* text=auto

*.bat  text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.docx binary
*.pdf  binary
*.zip  binary
*.doc  binary
